[Unit]
Description=Headless Grok Bot local-computer node
Documentation=https://github.com/TillmanBuildsTech/groknode
Wants=network-online.target
After=network-online.target
# Refuse to start until credentials exist and the runtime is compatible.
ConditionPathExists=/var/lib/groknode/.config/groknode/credentials.json
StateDirectory=groknode

[Service]
Type=simple
User=grokbot
Group=grokbot
EnvironmentFile=/etc/groknode/environment
# Start the daemon. Pre-flight checks (groknode check --local) are manual
# for diagnosing issues; the service itself gates on credential existence.
ExecStart=/usr/local/libexec/groknode/groknode run
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillMode=mixed

# --- Hardening ---------------------------------------------------------------
# The local-exec daemon legitimately spawns subprocesses and does file I/O, so
# the sandbox boundary is "its own state dir only", not a locked syscall set.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=groknode
RuntimeDirectory=groknode
ReadWritePaths=/var/lib/groknode /run/groknode
# Grok's tasks run under this unit; to let them touch specific project dirs,
# add those paths to ReadWritePaths above (otherwise they are read-only/hidden).
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
